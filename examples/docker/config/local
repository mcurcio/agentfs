# Settings for a volume with no remote (docs/docker.md): its history stays
# in the Docker volume. Every key is in docs/configuration.md; a fragment
# must not set agentfs.volume or agentfs.branch (`agentfs init` sets them).
# A volume with no [remote] section is local-only: it records and commits,
# and never pushes; status and telemetry say local-only.
[agentfs]
	commitWindow = 200ms
