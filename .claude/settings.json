{
  "extraKnownMarketplaces": {
    "mcurcio-skills": {
      "source": { "source": "github", "repo": "mcurcio/skills" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "rules@mcurcio-skills": true,
    "workflow@mcurcio-skills": true,
    "releases@mcurcio-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/install-plugins.sh --hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
