{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agentfs-sidecar values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "",
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "volume": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "settings": {
          "type": "string"
        },
        "exclude": {
          "type": "string"
        },
        "attributes": {
          "type": "string"
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "stringData": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOncePod",
              "ReadWriteOnce"
            ]
          }
        },
        "size": {
          "type": [
            "string",
            "integer"
          ]
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "onStaleMount": {
      "type": "string",
      "enum": [
        "recover",
        "hold"
      ]
    },
    "sealMountpoint": {
      "type": "boolean"
    },
    "sandboxOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "volumeName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/.+[^/]$"
        },
        "owner": {
          "type": "string",
          "pattern": "^([0-9]+:[0-9]+)?$"
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "resources": {
      "type": "object"
    }
  }
}
