# CI: a source and its forks (ci/e2e-csi-forks.sh). The source pushes to
# origin, its forks to `forks` (agentfsForkRemote), every 2 seconds.
[agentfs]
	pushInterval = 2s
	commitWindow = 100ms

[remote "origin"]
	url = http://git-server.agentfs-csi.svc.cluster.local:8080/git/history.git
	agentfsCredentials = /etc/agentfs-csi/credentials/ci-origin

[remote "forks"]
	url = http://git-server.agentfs-csi.svc.cluster.local:8080/git/forks.git
	agentfsCredentials = /etc/agentfs-csi/credentials/ci-origin
	agentfsForkRemote = true
