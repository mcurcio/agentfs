# CI: a source volume and its fork claims (ci/e2e-csi-forks.sh,
# ci/e2e-csi-fork-of-fork.sh). A fork claim's fork lives in its source's
# volume, so it needs no remote of its own. The remote on the runner's git
# server is logged as not built at each host's boot
# (`not built: remote.origin.url (push): ...`) and never reached, which
# the scripts check.
[agentfs]
	pushInterval = 2s

[remote "origin"]
	url = http://git-server.agentfs-csi.svc.cluster.local:8080/git/history.git
	agentfsCredentials = /etc/agentfs-csi/credentials/ci-origin
