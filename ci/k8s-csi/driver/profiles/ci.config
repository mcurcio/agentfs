# CI: a remote on the runner's git server. Push is not built on tree
# volumes yet: each volume's host logs it as not built
# (`not built: remote.origin.url (push): ...`) and never reaches the
# server, which ci/e2e-csi.sh checks.
[agentfs]
	pushInterval = 2s

[remote "origin"]
	url = http://git-server.agentfs-csi.svc.cluster.local:8080/git/history.git
	agentfsCredentials = /etc/agentfs-csi/credentials/ci-origin
