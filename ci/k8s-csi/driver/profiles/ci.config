# CI: push to the runner's git server every 2 seconds.
[agentfs]
	pushInterval = 2s
	commitWindow = 100ms

[remote "origin"]
	url = http://git-server.agentfs-csi.svc.cluster.local:8080/git/history.git
	agentfsCredentials = /etc/agentfs-csi/credentials/ci-origin

# A custom committer email (design §9), checked exactly by ci/e2e-csi.sh.
[agentfs "identity"]
	committerEmail = {pod}.{podUid}@{namespace}.{volume}.csi.invalid
