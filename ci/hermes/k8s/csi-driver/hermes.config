# The `hermes` profile of ci/e2e-hermes-kind.sh csi: the operator settings
# of deploy/examples/hermes/config, with the runner's git server Service
# (ci/k8s-csi/driver) as the remote. Push and the patch queue are not
# built on tree volumes: the volume's host logs the remote and the patch
# source as not built at every boot (`not built: remote.origin.url
# (push): ...`, `not built: agentfs.patchremote (patches): ...`), which
# the suite checks, and serves anyway.
[agentfs]
	# Nested repositories (a skill cloned with git) are not recorded.
	nested = exclude
	pushInterval = 60s
	# Where iac queues patches to Hermes' files.
	patchRemote = origin

[remote "origin"]
	url = http://git-server.agentfs-csi.svc.cluster.local:8080/git/history.git
	agentfsCredentials = /etc/agentfs-csi/credentials/ci-origin
