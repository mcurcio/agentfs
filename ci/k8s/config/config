# CI: a remote on the runner's git server. Push is not built on tree
# volumes yet: ci/e2e-kind.sh checks that the sidecar logs it as not built
# at every boot and that nothing reaches the server.
[remote "origin"]
	url = http://git-server.agentfs-e2e.svc.cluster.local:8080/git/history.git
	agentfsCredentials = /run/secrets/agentfs/origin
