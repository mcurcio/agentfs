# CI: push to the runner's git server every 2 seconds.
[agentfs]
	pushInterval = 2s
	commitWindow = 100ms

[remote "origin"]
	url = http://git-server.agentfs-e2e.svc.cluster.local:8080/git/history.git
	agentfsCredentials = /run/secrets/agentfs/origin

# Custom identity templates (design §9), checked exactly by ci/e2e-kind.sh.
[agentfs "identity"]
	committerName = {pod} on {node}
	committerEmail = {podUid}@{namespace}.{volume}.ci.invalid
	authorEmail = uid-{uid}.gid-{gid}@{volume}.ci.invalid
