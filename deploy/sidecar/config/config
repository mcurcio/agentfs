# The operator settings, included from the volume's operator settings file
# (`agentfs init --include /etc/agentfs/config`) and read at every mount.
# Every key is in docs/configuration.md.
#
# Push is not built on tree volumes yet: the sidecar serves anyway and
# logs each of these keys at every boot, one line per key, for example
#
#   not built: remote.origin.url (push): this volume pushes to no remote yet; its history stays in the state area
#
# and exports the agentfs.not_built gauge (alert AgentfsNotBuilt). The
# history stays in /data/state/history.git until push is built.
[agentfs]
	pushInterval = 60s

[remote "origin"]
	url = https://git.example.com/acme/agent-history.git
	agentfsCredentials = /run/secrets/agentfs/origin

# Over SSH instead (the Secret holds ssh-privatekey and known_hosts):
# [remote "origin"]
# 	url = ssh://git@git.example.com/acme/agent-history.git
# 	agentfsSshKey = /run/secrets/agentfs/ssh-privatekey
# 	agentfsKnownHosts = /run/secrets/agentfs/known_hosts
