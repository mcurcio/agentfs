# Operator settings and remotes, included from the state area's config
# (`agentfs init --include /etc/agentfs/config`, design §4.3). Every key is
# in docs/configuration.md. A fragment must not set agentfs.volume or
# agentfs.branch: the init container sets them from AGENTFS_VOLUME.
[agentfs]
	pushInterval = 60s

[remote "origin"]
	url = https://git.example.com/acme/agent-history.git
	agentfsCredentials = /run/secrets/agentfs/origin

# Over SSH instead (the Secret holds ssh-privatekey and known_hosts):
# [remote "origin"]
# 	url = ssh://git@git.example.com/acme/agent-history.git
# 	agentfsSshKey = /run/secrets/agentfs/ssh-privatekey
# 	agentfsSshKeyPassphrase = /run/secrets/agentfs/passphrase   # if encrypted
# 	agentfsKnownHosts = /run/secrets/agentfs/known_hosts

# Git LFS (design §7; docs/configuration.md#git-lfs), off by default. Files
# over the threshold go to the remote's LFS endpoint; this one is derived
# from the url (<url>/info/lfs) and reuses agentfsCredentials. A separate
# LFS host takes its own credentials file from the same Secret:
# [agentfs]
# 	lfsThreshold = 8m
# [remote "origin"]
# 	lfsurl = https://lfs.example.com/acme/agent-history
# 	agentfsLfsCredentials = /run/secrets/agentfs/origin-lfs
