# The `example` profile: a StorageClass with `profile: example` gets this
# fragment, included from every volume's state area (design §4.3, §14.2).
# Every key is in docs/configuration.md. A profile must not set
# agentfs.volume or agentfs.branch: the driver sets them per volume.
[agentfs]
	pushInterval = 60s

[remote "origin"]
	url = https://git.example.com/acme/agent-history.git
	agentfsCredentials = /etc/agentfs-csi/credentials/example-origin
