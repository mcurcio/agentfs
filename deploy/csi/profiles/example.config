# The `example` profile: a StorageClass with `profile: example` gets this
# fragment, included from every volume's state area.
# Every key is in docs/configuration.md. A profile must not set
# agentfs.volume or agentfs.branch: the driver sets them per volume.
#
# Push is not built on tree volumes yet: the volume serves anyway, and its
# host logs the remote and pushInterval as not built at every start
# (`not built: remote.origin.url (push): ...`), counted by the
# agentfs.not_built gauge. The history stays in the volume's state area.
[agentfs]
	pushInterval = 60s

[remote "origin"]
	url = https://git.example.com/acme/agent-history.git
	agentfsCredentials = /etc/agentfs-csi/credentials/example-origin
