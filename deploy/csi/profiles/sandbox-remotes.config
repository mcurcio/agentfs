# The `sandbox-remotes` profile: an unlinked fork class's own remotes
# (`remotes: sandbox-remotes`, csi.md §14). It holds only
# `[remote "<name>"]` sections (and `lfs.url` or `lfs.pushurl`): anything
# else is refused. Every fork of such a class pushes here, never to its
# source's remotes. Every key is in docs/configuration.md.
[remote "sandbox"]
	url = https://git.example.com/acme/sandbox-history.git
	agentfsCredentials = /etc/agentfs-csi/credentials/sandbox
